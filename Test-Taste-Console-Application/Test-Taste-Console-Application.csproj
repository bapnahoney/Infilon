<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Test_Taste_Console_Application</RootNamespace>
        <!-- Id used by "dotnet user-secrets" so the API key is stored outside the repository. -->
        <UserSecretsId>5b0c2f0e-7d1a-4c55-9b0e-3f6a1c2d8e41</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
      <None Remove="FileOutput\" />
      <None Remove="Domain\Objects\" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="log4net" Version="2.0.17" />
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.0" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
      <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
<None Update="log4net.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="FileOutput\" />
      <Folder Include="Domain\Objects\" />
    </ItemGroup>
</Project>
